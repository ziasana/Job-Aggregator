# Database (must match docker-compose.yml defaults, or override both)
DB_PORT=5434
DB_NAME=job_aggregator
DB_USER=job_aggregator
DB_PASSWORD=job_aggregator

# Adzuna (register a free account at https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Bundesagentur fuer Arbeit Jobsuche API
# Community-documented shared key, not an officially sanctioned third-party
# credential. See README for details.
BUNDESAGENTUR_API_KEY=jobboerse-jobsuche

# Admin dashboard (HTTP Basic auth on /api/admin/**) - change these before deploying
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
