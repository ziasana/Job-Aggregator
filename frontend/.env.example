# Base URL of the Spring Boot backend. Fetched server-side only (Server
# Components), so the browser never sees this and no CORS config is needed.
API_BASE_URL=http://localhost:8080

# Must match the backend's ADMIN_USERNAME/ADMIN_PASSWORD (see ../.env.example).
# Gates /admin (middleware.ts) and authenticates server-side calls to
# /api/admin/** (lib/adminApi.ts) - never sent to the browser.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
